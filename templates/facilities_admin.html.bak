  </div><!-- /main -->
</div><!-- /layout -->

<!-- ══════════ MODAIS ══════════ -->



<!-- Modal: Limpeza -->
<div class="fac-modal" id="modalLimpeza">
  <div class="modal-box">
    <h2><i class="fas fa-broom"></i> Nova Limpeza</h2>
    <div class="fac-form-group"><label>Título *</label><input type="text" id="limpezaTitulo" placeholder="Ex: Limpeza geral escritório"></div>
    <div class="fac-form-group"><label>Local</label><input type="text" id="limpezaLocal" placeholder="Ex: Sala 01"></div>
    <div class="fac-form-row">
      <div class="fac-form-group"><label>Data *</label><input type="date" id="limpezaData"></div>
      <div class="fac-form-group"><label>Responsável</label><select id="limpezaColaborador"></select></div>
    </div>
    <div class="fac-form-row">
      <div class="fac-form-group"><label>Hora Início</label><input type="time" id="limpezaHoraInicio"></div>
      <div class="fac-form-group"><label>Hora Fim</label><input type="time" id="limpezaHoraFim"></div>
    </div>
    <div class="fac-modal-actions">
      <button class="btn btn-ghost" onclick="closeModal('modalLimpeza')">Cancelar</button>
      <button class="btn btn-primary" onclick="salvarLimpeza()">Salvar</button>
    </div>
  </div>
</div>

<!-- Modal: Projeto -->
<div class="fac-modal" id="modalProjeto">
  <div class="modal-box">
    <h2><i class="fas fa-tasks"></i> Novo Projeto</h2>
    <div class="fac-form-group"><label>Nome do Projeto *</label><input type="text" id="projetoNome" placeholder="Ex: Reforma sala reunião"></div>
    <div class="fac-form-group"><label>Cliente</label><input type="text" id="projetoCliente" placeholder="Nome do cliente"></div>
    <div class="fac-form-group"><label>Telefone</label><input type="text" id="projetoTelefone" placeholder="(00) 00000-0000"></div>
    <div class="fac-form-group"><label>Observações</label><textarea id="projetoObs" rows="3"></textarea></div>
    <div class="fac-modal-actions">
      <button class="btn btn-ghost" onclick="closeModal('modalProjeto')">Cancelar</button>
      <button class="btn btn-primary" onclick="salvarProjeto()">Salvar</button>
    </div>
  </div>
</div>

<!-- Modal: Colaborador -->
<div class="fac-modal" id="modalColaborador">
  <div class="modal-box">
    <h2><i class="fas fa-user-plus"></i> Novo Colaborador</h2>
    <div class="fac-form-group"><label>Nome *</label><input type="text" id="colaboradorNome" placeholder="Nome completo"></div>
    <div class="fac-form-row">
      <div class="fac-form-group"><label>Cargo</label><input type="text" id="colaboradorCargo" placeholder="Ex: Auxiliar"></div>
      <div class="fac-form-group"><label>Setor</label><input type="text" id="colaboradorSetor" placeholder="Ex: Produção"></div>
    </div>
    <div class="fac-form-group"><label>Nível de Acesso</label>
      <select id="colaboradorNivel">
        <option value="solicitante">Solicitante</option>
        <option value="gestor">Gestor (pode aprovar)</option>
      </select>
    </div>
    <div class="fac-modal-actions">
      <button class="btn btn-ghost" onclick="closeModal('modalColaborador')">Cancelar</button>
      <button class="btn btn-primary" onclick="salvarColaborador()">Salvar</button>
    </div>
  </div>
</div>

<!-- Modal: Material -->
<div class="fac-modal" id="modalMaterial">
  <div class="modal-box">
    <h2><i class="fas fa-box"></i> Novo Material EPI/Uniforme</h2>
    <div class="fac-form-row">
      <div class="fac-form-group"><label>Código Interno *</label><input type="text" id="materialCodigo" placeholder="Ex: EPI001"></div>
      <div class="fac-form-group"><label>Tipo</label>
        <select id="materialTipo"><option value="epi">EPI</option><option value="uniforme">Uniforme</option></select>
      </div>
    </div>
    <div class="fac-form-group"><label>Nome *</label><input type="text" id="materialNome" placeholder="Ex: Luva de proteção"></div>
    <div class="fac-modal-actions">
      <button class="btn btn-ghost" onclick="closeModal('modalMaterial')">Cancelar</button>
      <button class="btn btn-primary" onclick="salvarMaterial()">Salvar</button>
    </div>
  </div>
</div>

<!-- Modal: Chamado -->
<div class="fac-modal" id="modalChamado">
  <div class="modal-box">
    <h2><i class="fas fa-ticket-alt"></i> Novo Chamado</h2>
    <div class="fac-form-group"><label>Título *</label><input type="text" id="chamTitulo" placeholder="Descreva brevemente o chamado"></div>
    <div class="fac-form-row">
      <div class="fac-form-group"><label>Categoria</label>
        <select id="chamCategoria">
          <option value="manutencao">Manutenção</option>
          <option value="limpeza">Limpeza</option>
          <option value="reposicao">Reposição</option>
          <option value="outros">Outros</option>
        </select>
      </div>
      <div class="fac-form-group"><label>Prioridade</label>
        <select id="chamPrioridade">
          <option value="baixa">Baixa</option>
          <option value="media" selected>Média</option>
          <option value="alta">Alta</option>
          <option value="urgente">Urgente</option>
        </select>
      </div>
    </div>
    <div class="fac-form-group"><label>Local / Área</label><input type="text" id="chamLocal" placeholder="Ex: Galpão B, Linha 3"></div>
    <div class="fac-form-group"><label>Responsável</label><input type="text" id="chamResponsavel" placeholder="Nome ou setor responsável"></div>
    <div class="fac-form-group"><label>Descrição Detalhada</label><textarea id="chamDescricao" rows="3" placeholder="Detalhes adicionais, equipamentos envolvidos, etc."></textarea></div>
    <div class="fac-modal-actions">
      <button class="btn btn-ghost" onclick="closeModal('modalChamado')">Cancelar</button>
      <button class="btn btn-primary" onclick="salvarChamado()">Abrir Chamado</button>
    </div>
  </div>
</div>

<!-- Modal: Estoque Item -->
<div class="fac-modal" id="modalEstoque">
  <div class="modal-box">
    <h2><i class="fas fa-boxes"></i> <span id="estModalTitle">Novo Item de Estoque</span></h2>
    <input type="hidden" id="estId">
    <div class="fac-form-group"><label>Material EPI/Uniforme *</label>
      <select id="estMaterialId"></select>
    </div>
    <div class="fac-form-row">
      <div class="fac-form-group"><label>N° CA (Certificado)</label><input type="text" id="estCA" placeholder="Ex: 12345"></div>
      <div class="fac-form-group"><label>Lote</label><input type="text" id="estLote" placeholder="Ex: 2024-01"></div>
    </div>
    <div class="fac-form-row">
      <div class="fac-form-group"><label>Validade</label><input type="date" id="estValidade"></div>
      <div class="fac-form-group"><label>Localização</label><input type="text" id="estLocalizacao" placeholder="Ex: Prateleira A3"></div>
    </div>
    <div class="fac-form-row">
      <div class="fac-form-group"><label>Quantidade em Estoque</label><input type="number" id="estQtd" min="0" value="0"></div>
      <div class="fac-form-group"><label>Qtd. Mínima</label><input type="number" id="estQtdMin" min="0" value="5"></div>
    </div>
    <div class="fac-modal-actions">
      <button class="btn btn-ghost" onclick="closeModal('modalEstoque')">Cancelar</button>
      <button class="btn btn-primary" onclick="salvarEstoque()">Salvar</button>
    </div>
  </div>
</div>

<!-- Modal: Atualizar Status Chamado -->
<div class="fac-modal" id="modalChamadoStatus">
  <div class="modal-box" style="max-width:400px">
    <h2><i class="fas fa-edit"></i> Atualizar Chamado</h2>
    <input type="hidden" id="chamStatusId">
    <div class="fac-form-group"><label>Novo Status</label>
      <select id="chamNovoStatus">
        <option value="em_analise">Em Análise</option>
        <option value="aprovado">Aprovado</option>
        <option value="em_execucao">Em Execução</option>
        <option value="concluido">Concluído</option>
        <option value="cancelado">Cancelado</option>
      </select>
    </div>
    <div class="fac-form-group"><label>Observação</label><textarea id="chamObs" rows="2" placeholder="Comentário opcional"></textarea></div>
    <div class="fac-modal-actions">
      <button class="btn btn-ghost" onclick="closeModal('modalChamadoStatus')">Cancelar</button>
      <button class="btn btn-primary" onclick="atualizarStatusChamado()">Atualizar</button>
    </div>
  </div>
</div>

<!-- Modal: Baixa Estoque -->
<div class="fac-modal" id="modalBaixaEstoque">
  <div class="modal-box" style="max-width:400px">
    <h2><i class="fas fa-minus-circle"></i> Dar Baixa no Estoque</h2>
    <input type="hidden" id="baixaEstId">
    <div id="baixaEstInfo" style="background:#f8fafc;border-radius:8px;padding:12px;margin-bottom:14px;font-size:13px;color:#475569"></div>
    <div class="fac-form-group"><label>Quantidade a Retirar *</label><input type="number" id="baixaQtd" min="1" value="1"></div>
    <div class="fac-form-group"><label>Observação</label><input type="text" id="baixaObs" placeholder="Ex: Entregue para João - EPI001"></div>
    <div class="fac-modal-actions">
      <button class="btn btn-ghost" onclick="closeModal('modalBaixaEstoque')">Cancelar</button>
      <button class="btn btn-red" onclick="confirmarBaixaEstoque()"><i class="fas fa-minus"></i> Confirmar Baixa</button>
    </div>
  </div>
</div>

<div class="toast-container" id="toastContainer"></div>

<script>
let colaboradores = [];
let currentPage = 'dashboard';

// ─── NAVIGATION ───────────────────────────────────────────
function nav(page) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  const pageEl = document.getElementById('page' + page.charAt(0).toUpperCase() + page.slice(1));
  const navEl = document.getElementById('nav-' + page);
  if (pageEl) pageEl.classList.add('active');
  if (navEl) navEl.classList.add('active');
  currentPage = page;
  const titles = {
    dashboard:'Dashboard', epi:'Solicitações EPI', alertas:'Alertas NR-6', estoque:'Estoque',
    chamados:'Chamados', limpeza:'Limpeza', templates:'Templates Limpeza', projetos:'Projetos',
    colaboradores:'Colaboradores', materiais:'Materiais EPI', ciclos:'Ciclos NR-6',
    relatorios:'Relatórios', auditoria:'Auditoria'
  };
  const subs = {
    dashboard:'Visão Geral', epi:'EPI & Uniformes', alertas:'NR-6 Vencimentos', estoque:'Controle de Estoque',
    chamados:'Tickets de Facilities', limpeza:'Cronograma', templates:'Checklists', projetos:'Obras e Projetos',
    colaboradores:'Cadastro', materiais:'EPI & Uniformes', ciclos:'Troca Periódica',
    relatorios:'Análises', auditoria:'Histórico de Ações'
  };
  document.getElementById('topbarTitle').textContent = titles[page] || page;
  document.getElementById('topbarSub').textContent = subs[page] || '';
  // Load data for each page
  if (page === 'dashboard') loadDashboard();
  else if (page === 'epi') loadEpi();
  else if (page === 'alertas') loadAlertas();
  else if (page === 'estoque') loadEstoque();
  else if (page === 'chamados') loadChamados();
  else if (page === 'limpeza') loadLimpezas();
  else if (page === 'templates') loadTemplates();
  else if (page === 'projetos') loadProjetos();
  else if (page === 'colaboradores') loadColaboradoresTable();
  else if (page === 'materiais') loadMateriais();
  else if (page === 'ciclos') loadCiclos();
  else if (page === 'relatorios') loadRelatorios();
  else if (page === 'auditoria') loadAuditoria();
}

function refreshPage() { nav(currentPage); }
function toggleSidebar() {
  document.getElementById('sidebar').classList.toggle('open');
}
// Close sidebar on overlay click
document.addEventListener('click', e => {
  const sb = document.getElementById('sidebar');
  if (sb.classList.contains('open') && !sb.contains(e.target) && !e.target.closest('.hamburger')) {
    sb.classList.remove('open');
  }
});

// ─── INIT ───────────────────────────────────────────────
async function init() {
  await loadColaboradores();
  await loadDashboard();
  await loadEpi();
  await updateBadges();
}

// ─── DASHBOARD ──────────────────────────────────────────
async function loadDashboard() {
  try {
    const r = await fetch('/api/facilities/dashboard');
    if (!r.ok) return;
    const d = await r.json();
    const set = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val ?? 0; };
    set('dEpiPend',    d.epi_pendentes    || 0);
    set('dEpiLib',     d.epi_liberados_hoje || 0);
    set('dVencidos',   (d.epi_vencido || 0) + (d.epi_vence_30d || 0));
    set('dChamados',   d.chamados_abertos || 0);
    set('dEstoqBaixo', d.estoque_critico  || 0);
    set('dLimpezas',   d.limpezas_hoje    || 0);
    set('dProjetos',   d.projetos_ativos  || 0);
    set('dColabs',     d.colaboradores    || 0);
    // Dash quick EPI table
    if (d.ultimas_solicitacoes) {
      const tbody = document.getElementById('dashEpiBody');
      if (!d.ultimas_solicitacoes.length) {
        tbody.innerHTML = '<tr><td colspan="6" class="empty-state"><i class="fas fa-inbox"></i><p>Nenhuma solicitação recente</p></td></tr>';
      } else {
        tbody.innerHTML = d.ultimas_solicitacoes.slice(0, 8).map(s => `
          <tr>
            <td><strong>${s.colaborador_nome}</strong></td>
            <td>${s.nome_item}</td>
            <td>${s.solicitante_nome || '-'}</td>
            <td>${s.solicitado_em}</td>
            <td><span class="fac-badge ${s.status}">${s.status}</span></td>
            <td>${s.status==='solicitado'?`<button class="btn btn-green btn-sm" onclick="aprovarEpi(${s.id},'liberar')"><i class="fas fa-check"></i></button><button class="btn btn-red btn-sm" onclick="aprovarEpi(${s.id},'negar')"><i class="fas fa-times"></i></button>`:''}</td>
          </tr>`).join('');
      }
    }
  } catch(e) { console.error('Erro loadDashboard:', e); }
}

async function updateBadges() {
  try {
    const r = await fetch('/api/facilities/badge');
    if (!r.ok) return;
    const d = await r.json();
    const setB = (id, val) => {
      const el = document.getElementById(id);
      if (!el) return;
      if (val > 0) { el.textContent = val; el.style.display = ''; }
      else el.style.display = 'none';
    };
    setB('nbEpi', d.epi_pendentes || 0);
    setB('nbAlertas', (d.epi_vencido || 0) + (d.epi_vence_30d || 0));
    setB('nbChamados', d.chamados_abertos || 0);
    setB('nbEstoque', d.estoque_critico || 0);
  } catch(e) {}
}
setInterval(updateBadges, 60000);


                    <option value="">Todos status</option>
