{% block extra_js %}
<script>
let colaboradores = [];

async function init() {
    await loadDashboard();
    await loadColaboradores();
    await loadEpi();
}

async function loadDashboard() {
    const r = await fetch('/api/facilities/dashboard');
    if (!r.ok) return;
    const d = await r.json();
    document.getElementById('metricEpiPendentes').textContent = d.epi_pendentes || 0;
    document.getElementById('metricEpiLiberados').textContent = d.epi_liberados_hoje || 0;
    document.getElementById('metricLimpezasHoje').textContent = d.limpezas_hoje || 0;
    document.getElementById('metricProjetosAtivos').textContent = d.projetos_ativos || 0;

    // Badges visuais nas tabs
    const bEpi = document.getElementById('badgeEpi');
    if (bEpi) {
        if (d.epi_pendentes > 0) { bEpi.textContent = d.epi_pendentes; bEpi.style.display=''; }
        else bEpi.style.display='none';
    }
    const bAlert = document.getElementById('badgeAlertas');
    const totalAlert = (d.epi_vencido || 0) + (d.epi_vence_30d || 0);
    if (bAlert) {
        if (totalAlert > 0) { bAlert.textContent = totalAlert; bAlert.style.display=''; }
        else bAlert.style.display='none';
    }
}

// Polling leve para badge de pendentes (60s)
setInterval(async () => {
    try {
        const r = await fetch('/api/facilities/badge');
        if (!r.ok) return;
        const d = await r.json();
        const bEpi = document.getElementById('badgeEpi');
        if (bEpi) {
            if (d.epi_pendentes > 0) { bEpi.textContent = d.epi_pendentes; bEpi.style.display=''; }
            else bEpi.style.display='none';
        }
    } catch(e){}
}, 60000);

async function loadColaboradores() {
    const r = await fetch('/api/facilities/colaboradores');
    const d = await r.json();
    colaboradores = d.rows || [];
    // Popular selects
    const selLimpeza = document.getElementById('limpezaColaborador');
    selLimpeza.innerHTML = '<option value="">-- Selecione --</option>';
    colaboradores.forEach(c => {
        selLimpeza.innerHTML += `<option value="${c.id}">${c.nome}</option>`;
    });
}

function switchTab(tab) {
    document.querySelectorAll('.fac-tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.fac-panel').forEach(p => p.classList.remove('active'));
    document.querySelector(`.fac-tab[onclick*="${tab}"]`).classList.add('active');
    document.getElementById('panel' + tab.charAt(0).toUpperCase() + tab.slice(1)).classList.add('active');
    
    if (tab === 'epi') loadEpi();
    else if (tab === 'alertas') loadAlertas();
    else if (tab === 'limpeza') loadLimpezas();
    else if (tab === 'templates') loadTemplates();
    else if (tab === 'projetos') loadProjetos();
    else if (tab === 'colaboradores') loadColaboradoresTable();
    else if (tab === 'materiais') loadMateriais();
    else if (tab === 'ciclos') loadCiclos();
    else if (tab === 'auditoria') loadAuditoria();
}

// ========== EPI ==========
let _debounceTimer = null;
function debounceEpi(){ clearTimeout(_debounceTimer); _debounceTimer = setTimeout(loadEpi, 350); }

function buildEpiQS(){
    const p = new URLSearchParams();
    const st = document.getElementById('filterEpiStatus').value; if (st) p.append('status', st);
    const tp = document.getElementById('filterEpiTipo')?.value; if (tp) p.append('tipo', tp);
    const q = document.getElementById('filterEpiBusca')?.value.trim(); if (q) p.append('busca', q);
    const ini = document.getElementById('filterEpiIni')?.value; if (ini) p.append('data_ini', ini);
    const fim = document.getElementById('filterEpiFim')?.value; if (fim) p.append('data_fim', fim);
    return p.toString();
}

async function loadEpi() {
    const qs = buildEpiQS();
    const r = await fetch(`/api/facilities/epi-solicitacoes?${qs}`);
    const d = await r.json();
    const tbody = document.getElementById('epiTableBody');
    if (!d.rows?.length) {
        tbody.innerHTML = '<tr><td colspan="9" class="fac-empty"><i class="fas fa-inbox"></i><br>Nenhuma solicitação encontrada.</td></tr>';
        updateLoteBar();
        return;
    }
    tbody.innerHTML = d.rows.map(s => `
        <tr>
            <td>${s.status === 'solicitado' ? `<input type="checkbox" class="epi-chk" value="${s.id}" onchange="updateLoteBar()">` : ''}</td>
            <td><strong>${s.colaborador_nome}</strong>${s.colaborador_setor ? '<br><small style="color:#64748b">' + s.colaborador_setor + '</small>' : ''}</td>
            <td>${s.solicitante_nome || '-'}</td>
            <td>${s.nome_item}${s.proxima_troca_em ? '<br><small style="color:#888">Próx. troca: ' + s.proxima_troca_em + '</small>' : ''}</td>
            <td>${s.tamanho || '-'}</td>
            <td>${s.quantidade}</td>
            <td>${s.solicitado_em}</td>
            <td><span class="fac-badge ${s.status}">${s.status === 'solicitado' ? 'Pendente' : s.status}</span></td>
            <td>
                ${s.status === 'solicitado' ? `
                    <button class="fac-btn fac-btn-sm fac-btn-green" title="Liberar" onclick="aprovarEpi(${s.id}, 'liberar')"><i class="fas fa-check"></i></button>
                    <button class="fac-btn fac-btn-sm fac-btn-red" title="Negar" onclick="aprovarEpi(${s.id}, 'negar')"><i class="fas fa-times"></i></button>
                ` : ''}
                ${s.status === 'liberado' ? `<a class="fac-btn fac-btn-sm fac-btn-blue" title="Registrar Retirada" href="/facilities/retirar/${s.id}"><i class="fas fa-hand-paper"></i> Retirar</a>` : ''}
                <a class="fac-btn fac-btn-sm" title="Ficha Imprimível" href="/facilities/ficha-epi/${s.id}" target="_blank" style="background:#f0fdf4;color:#059669"><i class="fas fa-print"></i></a>
            </td>
        </tr>
    `).join('');
    updateLoteBar();
}

function toggleSelAll(cb){
    document.querySelectorAll('.epi-chk').forEach(x => x.checked = cb.checked);
    updateLoteBar();
}
function getSelIds(){
    return [...document.querySelectorAll('.epi-chk:checked')].map(x => +x.value);
}
function updateLoteBar(){
    const ids = getSelIds();
    const bar = document.getElementById('epiLoteBar');
    if (!bar) return;
    if (ids.length > 0) { bar.style.display='block'; document.getElementById('epiLoteCount').textContent = ids.length + ' selecionada(s)'; }
    else bar.style.display='none';
}
async function acaoLote(acao){
    const ids = getSelIds();
    if (ids.length === 0) return;
    let motivo = '';
    if (acao === 'negar' || acao === 'cancelar') {
        motivo = prompt('Motivo (' + acao + '):') || '';
    }
    if (!confirm(`Confirma ${acao} de ${ids.length} solicitação(ões)?`)) return;
    const r = await fetch('/api/facilities/epi-solicitacoes/acao-lote', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ ids, acao, motivo })
    });
    const d = await r.json();
    if (r.ok) { showToast(`Processadas: ${d.processadas}/${d.solicitadas}`, 'success'); loadEpi(); loadDashboard(); }
    else showToast(d.error || 'Erro em lote', 'error');
}

async function aprovarEpi(id, acao) {
    const r = await fetch(`/api/facilities/epi-solicitacoes/${id}/aprovar`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ acao })
    });
    if (r.ok) {
        showToast(acao === 'liberar' ? 'Solicitação liberada!' : 'Solicitação negada.', acao === 'liberar' ? 'success' : 'info');
        loadEpi();
        loadDashboard();
    } else {
        const d = await r.json();
        showToast(d.error || 'Erro ao processar.', 'error');
    }
}

// ========== Limpeza ==========
async function loadLimpezas() {
    const hoje = new Date().toISOString().slice(0, 10);
    const r = await fetch(`/api/facilities/limpezas?data_inicio=${hoje}`);
    const d = await r.json();
    const tbody = document.getElementById('limpezaTableBody');
    if (!d.rows?.length) {
        tbody.innerHTML = '<tr><td colspan="6" class="fac-empty"><i class="fas fa-calendar-check"></i><br>Nenhuma limpeza agendada.</td></tr>';
        return;
    }
    tbody.innerHTML = d.rows.map(l => `
        <tr>
            <td>${l.data_agendada_label}</td>
            <td><strong>${l.titulo}</strong></td>
            <td>${l.local || '-'}</td>
            <td>${l.colaborador_nome || '-'}</td>
            <td>${l.hora_inicio ? l.hora_inicio + (l.hora_fim ? ' - ' + l.hora_fim : '') : '-'}</td>
            <td><span class="fac-badge ${l.concluido ? 'liberado' : 'solicitado'}">${l.concluido ? 'Concluído' : 'Pendente'}</span></td>
        </tr>
    `).join('');
}

function openLimpezaModal() {
    document.getElementById('limpezaTitulo').value = '';
    document.getElementById('limpezaLocal').value = '';
    document.getElementById('limpezaData').value = new Date().toISOString().slice(0, 10);
    document.getElementById('limpezaColaborador').value = '';
    document.getElementById('limpezaHoraInicio').value = '';
    document.getElementById('limpezaHoraFim').value = '';
    document.getElementById('modalLimpeza').classList.add('show');
}

async function salvarLimpeza() {
    const titulo = document.getElementById('limpezaTitulo').value.trim();
    const data_agendada = document.getElementById('limpezaData').value;
    if (!titulo || !data_agendada) return showToast('Título e data são obrigatórios.', 'error');
    
    const r = await fetch('/api/facilities/limpezas', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            titulo,
            local: document.getElementById('limpezaLocal').value.trim(),
            data_agendada,
            colaborador_id: document.getElementById('limpezaColaborador').value || null,
            hora_inicio: document.getElementById('limpezaHoraInicio').value,
            hora_fim: document.getElementById('limpezaHoraFim').value
        })
    });
    if (r.ok) {
        showToast('Limpeza agendada!', 'success');
        closeModal('modalLimpeza');
        loadLimpezas();
    } else {
        const d = await r.json();
        showToast(d.error || 'Erro ao salvar.', 'error');
    }
}

// ========== Projetos ==========
async function loadProjetos() {
    const r = await fetch('/api/facilities/projetos');
    const d = await r.json();
    const tbody = document.getElementById('projetosTableBody');
    if (!d.rows?.length) {
        tbody.innerHTML = '<tr><td colspan="6" class="fac-empty"><i class="fas fa-tasks"></i><br>Nenhum projeto cadastrado.</td></tr>';
        return;
    }
    tbody.innerHTML = d.rows.map(p => `
        <tr>
            <td><code>${p.codigo}</code></td>
            <td><strong>${p.nome}</strong></td>
            <td>${p.cliente_nome || '-'}</td>
            <td>${p.tarefas_concluidas}/${p.tarefas_total}</td>
            <td><span class="fac-badge ${p.status === 'Em andamento' ? 'solicitado' : p.status === 'Concluído' ? 'liberado' : 'negado'}">${p.status}</span></td>
            <td><button class="fac-btn fac-btn-sm fac-btn-blue" onclick="verTarefas(${p.id})"><i class="fas fa-list"></i></button></td>
        </tr>
    `).join('');
}

function openProjetoModal() {
    document.getElementById('projetoNome').value = '';
    document.getElementById('projetoCliente').value = '';
    document.getElementById('projetoTelefone').value = '';
    document.getElementById('projetoObs').value = '';
    document.getElementById('modalProjeto').classList.add('show');
}

async function salvarProjeto() {
    const nome = document.getElementById('projetoNome').value.trim();
    if (!nome) return showToast('Nome é obrigatório.', 'error');
    
    const r = await fetch('/api/facilities/projetos', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            nome,
            cliente_nome: document.getElementById('projetoCliente').value.trim(),
            cliente_telefone: document.getElementById('projetoTelefone').value.trim(),
            observacoes: document.getElementById('projetoObs').value.trim()
        })
    });
    if (r.ok) {
        showToast('Projeto criado!', 'success');
        closeModal('modalProjeto');
        loadProjetos();
        loadDashboard();
    } else {
        const d = await r.json();
        showToast(d.error || 'Erro ao salvar.', 'error');
    }
}

function verTarefas(projetoId) {
    showToast('Funcionalidade de tarefas em desenvolvimento.', 'info');
}

// ========== Colaboradores ==========
async function loadColaboradoresTable() {
    const r = await fetch('/api/facilities/colaboradores');
    const d = await r.json();
    const tbody = document.getElementById('colaboradoresTableBody');
    if (!d.rows?.length) {
        tbody.innerHTML = '<tr><td colspan="5" class="fac-empty"><i class="fas fa-users"></i><br>Nenhum colaborador cadastrado.</td></tr>';
        return;
    }
    tbody.innerHTML = d.rows.map(c => `
        <tr>
            <td><strong>${c.nome}</strong></td>
            <td>${c.cargo || '-'}</td>
            <td>${c.setor || '-'}</td>
            <td><span class="fac-badge ${c.nivel_acesso === 'gestor' ? 'liberado' : 'solicitado'}">${c.nivel_acesso}</span></td>
            <td>-</td>
        </tr>
    `).join('');
}

function openColaboradorModal() {
    document.getElementById('colaboradorNome').value = '';
    document.getElementById('colaboradorCargo').value = '';
    document.getElementById('colaboradorSetor').value = '';
    document.getElementById('colaboradorNivel').value = 'solicitante';
    document.getElementById('modalColaborador').classList.add('show');
}

async function salvarColaborador() {
    const nome = document.getElementById('colaboradorNome').value.trim();
    if (!nome) return showToast('Nome é obrigatório.', 'error');
    
    const r = await fetch('/api/facilities/colaboradores', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            nome,
            cargo: document.getElementById('colaboradorCargo').value.trim(),
            setor: document.getElementById('colaboradorSetor').value.trim(),
            nivel_acesso: document.getElementById('colaboradorNivel').value
        })
    });
    if (r.ok) {
        showToast('Colaborador cadastrado!', 'success');
        closeModal('modalColaborador');
        loadColaboradoresTable();
        loadColaboradores();
    } else {
        const d = await r.json();
        showToast(d.error || 'Erro ao salvar.', 'error');
    }
}

// ========== Materiais ==========
async function loadMateriais() {
    const r = await fetch('/api/facilities/epi-materiais');
    const d = await r.json();
    const tbody = document.getElementById('materiaisTableBody');
    if (!d.rows?.length) {
        tbody.innerHTML = '<tr><td colspan="3" class="fac-empty"><i class="fas fa-boxes"></i><br>Nenhum material cadastrado.</td></tr>';
        return;
    }
    tbody.innerHTML = d.rows.map(m => `
        <tr>
            <td><code>${m.codigo_interno}</code></td>
            <td><strong>${m.nome}</strong></td>
            <td><span class="fac-badge ${m.tipo === 'epi' ? 'solicitado' : 'liberado'}">${m.tipo.toUpperCase()}</span></td>
        </tr>
    `).join('');
}

function openMaterialModal() {
    document.getElementById('materialCodigo').value = '';
    document.getElementById('materialNome').value = '';
    document.getElementById('materialTipo').value = 'epi';
    document.getElementById('modalMaterial').classList.add('show');
}

async function salvarMaterial() {
    const codigo = document.getElementById('materialCodigo').value.trim();
    const nome = document.getElementById('materialNome').value.trim();
    if (!codigo || !nome) return showToast('Código e nome são obrigatórios.', 'error');
    
    const r = await fetch('/api/facilities/epi-materiais', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            codigo_interno: codigo,
            nome,
            tipo: document.getElementById('materialTipo').value
        })
    });
    if (r.ok) {
        showToast('Material cadastrado!', 'success');
        closeModal('modalMaterial');
        loadMateriais();
    } else {
        const d = await r.json();
        showToast(d.error || 'Erro ao salvar.', 'error');
    }
}

// ========== Helpers ==========
function closeModal(id) {
    document.getElementById(id).classList.remove('show');
}

function showToast(msg, type = 'info') {
    const container = document.querySelector('.toast-container') || createToastContainer();
    const toast = document.createElement('div');
    toast.className = `toast ${type}`;
    toast.innerHTML = `<i class="fas fa-${type === 'success' ? 'check-circle' : type === 'error' ? 'times-circle' : 'info-circle'}"></i> ${msg}`;
    container.appendChild(toast);
    setTimeout(() => toast.classList.add('show'), 10);
    setTimeout(() => { toast.classList.remove('show'); setTimeout(() => toast.remove(), 300); }, 4000);
}

function createToastContainer() {
    const c = document.createElement('div');
    c.className = 'toast-container';
    c.style.cssText = 'position:fixed;top:20px;right:20px;z-index:9999';
    document.body.appendChild(c);
    return c;
}

// Fechar modais clicando fora
document.querySelectorAll('.fac-modal').forEach(modal => {
    modal.addEventListener('click', e => {
        if (e.target === modal) modal.classList.remove('show');
    });
});

// ========== Alertas NR-6 ==========
async function loadAlertas() {
    const r = await fetch('/api/facilities/epi/alertas-vencimento');
    const d = await r.json();
    const tbody = document.getElementById('alertasTableBody');
    if (!d.rows?.length) {
        tbody.innerHTML = '<tr><td colspan="7" class="fac-empty"><i class="fas fa-check-circle"></i><br>Nenhum EPI vencido ou próximo.</td></tr>';
        return;
    }
    tbody.innerHTML = d.rows.map(s => `
        <tr>
            <td><strong>${s.colaborador_nome}</strong></td>
            <td>${s.setor || '-'}</td>
            <td>${s.nome_item}</td>
            <td>${s.retirado_em}</td>
            <td><b>${s.proxima_troca_em}</b></td>
            <td><span class="fac-badge ${s.situacao === 'vencido' ? 'negado' : 'solicitado'}">${s.situacao === 'vencido' ? 'VENCIDO' : 'vence em ' + s.dias_restantes + 'd'}</span></td>
            <td><a class="fac-btn fac-btn-sm fac-btn-blue" href="/api/facilities/colaboradores/${s.colaborador_id}/ficha-epi-pdf" target="_blank"><i class="fas fa-file-pdf"></i></a></td>
        </tr>
    `).join('');
}
async function enviarLembretes() {
    if (!confirm('Enviar email de lembrete para todos com retirada pendente > 3 dias?')) return;
    const r = await fetch('/api/facilities/epi/enviar-lembretes', { method:'POST' });
    const d = await r.json();
    if (r.ok) showToast(`Lembretes enviados: ${d.enviados}`, 'success');
    else showToast('Erro ao enviar lembretes.', 'error');
}

// ========== Templates de Limpeza ==========
async function loadTemplates() {
    const r = await fetch('/api/facilities/limpeza-templates');
    const d = await r.json();
    const tbody = document.getElementById('templatesTableBody');
    if (!d.rows?.length) {
        tbody.innerHTML = '<tr><td colspan="7" class="fac-empty"><i class="fas fa-clipboard"></i><br>Nenhum template.</td></tr>';
        return;
    }
    tbody.innerHTML = d.rows.map(t => `
        <tr>
            <td><strong>${t.nome}</strong></td>
            <td>${t.local || '-'}</td>
            <td>${t.recorrencia}${t.dias_semana ? ' (' + t.dias_semana + ')' : ''}</td>
            <td>${t.hora_inicio || ''}${t.hora_fim ? ' - ' + t.hora_fim : ''}</td>
            <td>${t.colaborador_nome || '-'}</td>
            <td><a href="/facilities/qr/${t.qr_code}" target="_blank"><code>${t.qr_code}</code></a></td>
            <td>
                <button class="fac-btn fac-btn-sm" onclick="editTemplate(${t.id})"><i class="fas fa-edit"></i></button>
                <button class="fac-btn fac-btn-sm fac-btn-red" onclick="delTemplate(${t.id})"><i class="fas fa-trash"></i></button>
            </td>
        </tr>
    `).join('');
}
function openTemplateModal(t) {
    const nome = prompt('Nome do template:', t?.nome || ''); if (!nome) return;
    const local = prompt('Local:', t?.local || '') || '';
    const recorrencia = prompt('Recorrência (diaria/semanal/quinzenal/mensal):', t?.recorrencia || 'diaria') || 'diaria';
    const dias_semana = recorrencia==='semanal' ? (prompt('Dias (1-7 separados por vírgula, 1=seg):', t?.dias_semana || '1,2,3,4,5') || '') : '';
    const hora_inicio = prompt('Hora início (HH:MM, opcional):', t?.hora_inicio || '') || '';
    const hora_fim = prompt('Hora fim (HH:MM, opcional):', t?.hora_fim || '') || '';
    const checklistStr = prompt('Checklist (itens separados por |):', '') || '';
    const checklist = checklistStr.split('|').map(s => s.trim()).filter(Boolean);
    salvarTemplate(t?.id, { nome, local, recorrencia, dias_semana, hora_inicio, hora_fim, checklist });
}
async function salvarTemplate(id, body){
    const url = id ? `/api/facilities/limpeza-templates/${id}` : '/api/facilities/limpeza-templates';
    const r = await fetch(url, { method: id?'PUT':'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
    if (r.ok){ showToast('Template salvo','success'); loadTemplates(); } else showToast('Erro','error');
}
async function editTemplate(id) {
    const r = await fetch('/api/facilities/limpeza-templates'); const d = await r.json();
    const t = (d.rows||[]).find(x => x.id===id); if (t) openTemplateModal(t);
}
async function delTemplate(id) {
    if (!confirm('Excluir template?')) return;
    const r = await fetch(`/api/facilities/limpeza-templates/${id}`, { method:'DELETE' });
    if (r.ok) { showToast('Excluído','success'); loadTemplates(); }
}
async function gerarLimpezasSemana() {
    const r = await fetch('/api/facilities/limpezas/gerar-da-semana', { method:'POST' });
    const d = await r.json();
    if (r.ok) showToast(`Criados: ${d.criados} agendamentos`, 'success');
    else showToast('Erro','error');
}

// ========== Ciclos de Troca ==========
async function loadCiclos() {
    const r = await fetch('/api/facilities/ciclos-troca');
    const d = await r.json();
    const tbody = document.getElementById('ciclosTableBody');
    if (!d.rows?.length) { tbody.innerHTML = '<tr><td colspan="6" class="fac-empty">Nenhum ciclo cadastrado.</td></tr>'; return; }
    tbody.innerHTML = d.rows.map(c => `
        <tr>
            <td><strong>${c.palavra_chave}</strong></td>
            <td>${c.codigo_interno || '-'}</td>
            <td>${c.meses_validade}</td>
            <td>${c.descricao || '-'}</td>
            <td>${c.ativo?'Sim':'Não'}</td>
            <td>
                <button class="fac-btn fac-btn-sm" onclick="editCiclo(${c.id}, '${c.palavra_chave}', ${c.meses_validade}, '${(c.descricao||'').replace(/'/g,"\\'")}')"><i class="fas fa-edit"></i></button>
                <button class="fac-btn fac-btn-sm fac-btn-red" onclick="delCiclo(${c.id})"><i class="fas fa-trash"></i></button>
            </td>
        </tr>
    `).join('');
}
function openCicloModal() {
    const pk = prompt('Palavra-chave (ex: BOTINA):'); if (!pk) return;
    const meses = parseInt(prompt('Meses de validade:', '6') || '6');
    const desc = prompt('Descrição (opcional):') || '';
    salvarCiclo(null, { palavra_chave: pk, meses_validade: meses, descricao: desc });
}
function editCiclo(id, pk, meses, desc) {
    const npk = prompt('Palavra-chave:', pk); if (!npk) return;
    const nmeses = parseInt(prompt('Meses:', meses) || meses);
    const ndesc = prompt('Descrição:', desc) || '';
    salvarCiclo(id, { palavra_chave: npk, meses_validade: nmeses, descricao: ndesc });
}
async function salvarCiclo(id, body) {
    const url = id ? `/api/facilities/ciclos-troca/${id}` : '/api/facilities/ciclos-troca';
    const r = await fetch(url, { method: id?'PUT':'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
    if (r.ok) { showToast('Ciclo salvo','success'); loadCiclos(); }
    else showToast('Erro','error');
}
async function delCiclo(id) {
    if (!confirm('Excluir ciclo?')) return;
    const r = await fetch(`/api/facilities/ciclos-troca/${id}`, { method:'DELETE' });
    if (r.ok) { showToast('Excluído','success'); loadCiclos(); }
}

// ========== Auditoria ==========
async function loadAuditoria() {
    const p = new URLSearchParams();
    const e = document.getElementById('auditEntidade')?.value.trim(); if (e) p.append('entidade', e);
    const u = document.getElementById('auditUsuario')?.value.trim(); if (u) p.append('usuario', u);
    const ini = document.getElementById('auditIni')?.value; if (ini) p.append('data_ini', ini);
    const fim = document.getElementById('auditFim')?.value; if (fim) p.append('data_fim', fim);
    const r = await fetch(`/api/facilities/audit-log?${p.toString()}`);
    const d = await r.json();
    const tbody = document.getElementById('auditTableBody');
    if (!d.rows?.length) { tbody.innerHTML = '<tr><td colspan="6" class="fac-empty">Sem registros.</td></tr>'; return; }
    tbody.innerHTML = d.rows.map(r => `
        <tr>
            <td>${r.ts}</td>
            <td>${r.usuario}</td>
            <td>${r.entidade}</td>
            <td>${r.entidade_id ?? '-'}</td>
            <td><b>${r.acao}</b></td>
            <td><small>${(r.detalhes||'').replace(/</g,'&lt;')}</small></td>
        </tr>
    `).join('');
}

init();
</script>
{% endblock %}
