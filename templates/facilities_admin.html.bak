          <tbody id="ciclosTableBody"></tbody>
        </table>
      </div>
    </div>

    <!-- ─── RELATÓRIOS ─── -->
    <div class="page" id="pageRelatorios">
      <div class="sec-hdr">
        <h2 class="sec-title"><i class="fas fa-chart-bar" style="color:#7c3aed"></i> Relatórios</h2>
      </div>
      <div class="dash-quicklinks" style="grid-template-columns:repeat(auto-fit,minmax(200px,1fr))">
        <a href="/facilities/relatorio-consumo" class="qlink" target="_blank"><i class="fas fa-chart-pie" style="background:#ede9fe;color:#7c3aed"></i> Consumo por Setor</a>
        <a href="/facilities/almoxarife" class="qlink" target="_blank"><i class="fas fa-boxes" style="background:#dbeafe;color:#2563eb"></i> Pendências Almoxarife</a>
        <a href="/facilities/minhas-solicitacoes" class="qlink" target="_blank"><i class="fas fa-clipboard-list" style="background:#d1fae5;color:#059669"></i> Minhas Solicitações</a>
      </div>
      <div style="background:#fff;border-radius:14px;padding:24px;box-shadow:0 2px 8px rgba(18,40,58,.04);margin-top:16px">
        <h3 style="font-size:15px;font-weight:700;margin-bottom:16px;color:#0f172a"><i class="fas fa-boxes" style="color:#7c3aed;margin-right:6px"></i>Itens de Estoque — Visão Resumida</h3>
        <table class="fac-table"><thead><tr><th>Material</th><th>Qtd. Atual</th><th>Mínimo</th><th>Status</th></tr></thead>
        <tbody id="relEstoqueBody"></tbody></table>
      </div>
    </div>

    <!-- ─── AUDITORIA ─── -->
    <div class="page" id="pageAuditoria">
      <div class="sec-hdr">
        <h2 class="sec-title"><i class="fas fa-history" style="color:#64748b"></i> Log de Auditoria</h2>
        <div class="sec-actions">
          <button class="btn btn-ghost btn-sm" onclick="loadAuditoria()"><i class="fas fa-sync"></i></button>
        </div>
      </div>
      <div class="filter-bar">
        <input id="auditEntidade" placeholder="entidade" style="min-width:120px" onchange="loadAuditoria()">
        <input id="auditUsuario" placeholder="usuário" style="min-width:120px" onchange="loadAuditoria()">
        <input id="auditIni" type="date" onchange="loadAuditoria()">
        <input id="auditFim" type="date" onchange="loadAuditoria()">
      </div>
      <div class="tbl-wrap">
        <table class="fac-table">
          <thead><tr><th>Quando</th><th>Usuário</th><th>Entidade</th><th>ID</th><th>Ação</th><th>Detalhes</th></tr></thead>
