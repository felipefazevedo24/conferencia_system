<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Facilities | Columbia Machine</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
  /* ─── LAYOUT ─────────────────────────────────── */
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:'Segoe UI',system-ui,sans-serif;background:#f1f5f9;color:#1e293b;min-height:100vh;overflow-x:hidden}
  .layout{display:grid;grid-template-columns:240px 1fr;min-height:100vh}
  @media(max-width:900px){.layout{grid-template-columns:1fr}.sidebar{display:none}.sidebar.open{display:flex;position:fixed;inset:0;z-index:200;width:240px}}

  /* ─── SIDEBAR ────────────────────────────────── */
  .sidebar{background:#0f172a;color:#e2e8f0;display:flex;flex-direction:column;position:sticky;top:0;height:100vh;overflow-y:auto}
  .brand{padding:20px 16px 12px;border-bottom:1px solid #1e293b;display:flex;align-items:center;gap:10px}
  .brand img{height:28px;filter:brightness(0) invert(1) opacity(.9)}
  .brand-text{font-size:13px;font-weight:700;color:#e2e8f0;line-height:1.3}
  .brand-text small{display:block;color:#64748b;font-size:11px;font-weight:400}
  .nav-section{padding:8px 10px 2px;font-size:10px;font-weight:700;color:#475569;text-transform:uppercase;letter-spacing:.08em;margin-top:8px}
  .nav-item{display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:8px;color:#94a3b8;cursor:pointer;transition:all .15s;margin:2px 8px;border:none;background:transparent;width:calc(100% - 16px);text-align:left;font-size:13px;font-family:inherit;position:relative}
  .nav-item:hover{background:#1e293b;color:#e2e8f0}
  .nav-item.active{background:#1d4ed8;color:#fff}
  .nav-item i{width:18px;text-align:center;font-size:14px;flex-shrink:0}
  .nav-badge{background:#ef4444;color:#fff;border-radius:10px;padding:1px 7px;font-size:10px;font-weight:700;margin-left:auto}
  .nav-badge.warn{background:#f59e0b}
  .nav-divider{margin:8px 16px;border-top:1px solid #1e293b}
  .nav-back{display:flex;align-items:center;gap:8px;padding:10px 12px;color:#64748b;font-size:12px;cursor:pointer;margin:8px 8px 0;border-radius:8px;text-decoration:none;transition:color .15s}
  .nav-back:hover{color:#94a3b8;background:#1e293b}

  /* ─── MAIN ───────────────────────────────────── */
  .main{display:flex;flex-direction:column;min-height:100vh;overflow-x:hidden}
  .topbar{background:#fff;border-bottom:1px solid #e2e8f0;padding:0 24px;height:56px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:50;box-shadow:0 1px 4px rgba(18,40,58,.04)}
  .topbar-left{display:flex;align-items:center;gap:12px}
  .topbar-left h1{font-size:17px;font-weight:700;color:#0f172a}
  .topbar-left .breadcrumb{font-size:12px;color:#94a3b8}
  .topbar-right{display:flex;align-items:center;gap:8px}
  .topbar-btn{display:inline-flex;align-items:center;gap:6px;padding:7px 14px;border-radius:8px;font-size:12px;font-weight:600;border:none;cursor:pointer;transition:all .15s;font-family:inherit}
  .topbar-btn-green{background:#d1fae5;color:#059669}.topbar-btn-green:hover{background:#a7f3d0}
  .topbar-btn-ghost{background:#f1f5f9;color:#475569;border:1px solid #e2e8f0}.topbar-btn-ghost:hover{background:#e2e8f0}
  .hamburger{display:none;background:none;border:none;color:#64748b;font-size:20px;cursor:pointer;padding:8px}
  @media(max-width:900px){.hamburger{display:block}}

  /* ─── PAGES ──────────────────────────────────── */
  .page{display:none;padding:20px 24px 32px;animation:fadeIn .2s ease}
  .page.active{display:block}
  @keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}

  /* ─── KPI CARDS ──────────────────────────────── */
  .kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;margin-bottom:22px}
  .kpi{background:#fff;border-radius:14px;padding:18px;box-shadow:0 2px 8px rgba(18,40,58,.04);border-left:4px solid #3b82f6;display:flex;flex-direction:column;gap:2px}
  .kpi.amber{border-left-color:#f59e0b}
  .kpi.green{border-left-color:#22c55e}
  .kpi.purple{border-left-color:#8b5cf6}
  .kpi.red{border-left-color:#ef4444}
  .kpi.sky{border-left-color:#0ea5e9}
  .kpi.teal{border-left-color:#14b8a6}
  .kpi-val{font-size:28px;font-weight:800;color:#0f172a}
  .kpi-lbl{font-size:12px;color:#64748b;font-weight:600}
  .kpi-sub{font-size:11px;color:#94a3b8;margin-top:2px}

  /* ─── SECTION HEADER ─────────────────────────── */
  .sec-hdr{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;gap:8px;flex-wrap:wrap}
  .sec-title{font-size:17px;font-weight:700;color:#0f172a;display:flex;align-items:center;gap:8px}
  .sec-actions{display:flex;align-items:center;gap:6px;flex-wrap:wrap}

  /* ─── TABLE ──────────────────────────────────── */
  .tbl-wrap{background:#fff;border-radius:14px;overflow:hidden;box-shadow:0 2px 8px rgba(18,40,58,.04)}
  .fac-table{width:100%;border-collapse:collapse}
  .fac-table th{background:#f8fafc;padding:11px 14px;text-align:left;font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.05em;border-bottom:2px solid #e2e8f0;white-space:nowrap}
  .fac-table td{padding:13px 14px;border-bottom:1px solid #f1f5f9;font-size:13px;color:#334155;vertical-align:middle}
  .fac-table tr:hover td{background:#fafbff}
  .fac-table tr:last-child td{border-bottom:none}

  /* ─── BADGES ─────────────────────────────────── */
  .fac-badge{display:inline-flex;padding:3px 10px;border-radius:6px;font-size:11px;font-weight:700;text-transform:uppercase;white-space:nowrap}
  .fac-badge.solicitado{background:#fef3c7;color:#b45309}
  .fac-badge.liberado{background:#d1fae5;color:#059669}
  .fac-badge.retirado{background:#dcfce7;color:#15803d}
  .fac-badge.negado{background:#fee2e2;color:#dc2626}
  .fac-badge.cancelado{background:#f1f5f9;color:#64748b}
  .fac-badge.aberto{background:#dbeafe;color:#1d4ed8}
  .fac-badge.em_analise{background:#fef3c7;color:#b45309}
  .fac-badge.aprovado{background:#d1fae5;color:#065f46}
  .fac-badge.em_execucao{background:#ede9fe;color:#6d28d9}
  .fac-badge.concluido{background:#dcfce7;color:#14532d}
  .fac-badge.vencido{background:#fee2e2;color:#b91c1c}
  .fac-badge.urgente{background:#fee2e2;color:#b91c1c}
  .fac-badge.alta{background:#fef3c7;color:#b45309}
  .fac-badge.media{background:#dbeafe;color:#1e40af}
  .fac-badge.baixa{background:#f1f5f9;color:#475569}
  .fac-badge.ok-stock{background:#dcfce7;color:#15803d}
  .fac-badge.low-stock{background:#fef9c3;color:#a16207}
  .fac-badge.out-stock{background:#fee2e2;color:#b91c1c}

  /* ─── BUTTONS ────────────────────────────────── */
  .btn{display:inline-flex;align-items:center;gap:6px;padding:9px 18px;border-radius:8px;font-size:13px;font-weight:600;border:none;cursor:pointer;transition:all .15s;font-family:inherit;text-decoration:none}
  .btn-sm{padding:6px 12px;font-size:12px}
  .btn-primary{background:linear-gradient(135deg,#2563eb,#3b82f6);color:#fff;box-shadow:0 2px 8px rgba(37,99,235,.25)}
  .btn-primary:hover{transform:translateY(-1px);box-shadow:0 4px 14px rgba(37,99,235,.35)}
  .btn-green{background:#d1fae5;color:#059669}.btn-green:hover{background:#a7f3d0}
  .btn-red{background:#fee2e2;color:#dc2626}.btn-red:hover{background:#fecaca}
  .btn-blue{background:#dbeafe;color:#2563eb}.btn-blue:hover{background:#bfdbfe}
  .btn-sky{background:#e0f2fe;color:#0369a1}.btn-sky:hover{background:#bae6fd}
  .btn-ghost{background:#f8fafc;color:#475569;border:1px solid #e2e8f0}.btn-ghost:hover{background:#f1f5f9}
  .btn-amber{background:#fef3c7;color:#b45309}.btn-amber:hover{background:#fde68a}
  .btn-purple{background:#ede9fe;color:#7c3aed}.btn-purple:hover{background:#ddd6fe}

  /* ─── FILTERS BAR ────────────────────────────── */
  .filter-bar{background:#fff;border-radius:12px;padding:12px 16px;box-shadow:0 2px 8px rgba(18,40,58,.04);margin-bottom:14px;display:flex;gap:8px;flex-wrap:wrap;align-items:center}
  .filter-bar input,.filter-bar select{padding:8px 12px;border:1px solid #e2e8f0;border-radius:8px;font-size:13px;background:#f8fafc;font-family:inherit}
  .filter-bar input:focus,.filter-bar select:focus{outline:none;border-color:#3b82f6}

  /* ─── LOTE BAR ───────────────────────────────── */
  .lote-bar{display:none;padding:11px 16px;background:#eff6ff;border-radius:10px;margin-bottom:12px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;border:1px solid #bfdbfe}
  .lote-bar span{font-size:13px;font-weight:600;color:#1e40af}

  /* ─── MODAL ──────────────────────────────────── */
  .fac-modal{position:fixed;inset:0;background:rgba(15,23,42,.55);display:none;align-items:center;justify-content:center;z-index:9000;padding:16px}
  .fac-modal.show{display:flex}
  .modal-box{background:#fff;border-radius:18px;padding:24px;max-width:520px;width:100%;max-height:90vh;overflow-y:auto;box-shadow:0 24px 64px rgba(0,0,0,.2)}
  .modal-box h2{font-size:18px;font-weight:700;color:#0f172a;margin:0 0 18px;display:flex;align-items:center;gap:8px}
  .fac-form-group{margin-bottom:14px}
  .fac-form-group label{display:block;font-size:12px;font-weight:700;color:#475569;margin-bottom:5px;text-transform:uppercase;letter-spacing:.03em}
  .fac-form-group input,.fac-form-group select,.fac-form-group textarea{width:100%;padding:10px 13px;border:1px solid #e2e8f0;border-radius:9px;font-size:14px;background:#f8fafc;font-family:inherit}
  .fac-form-group input:focus,.fac-form-group select:focus,.fac-form-group textarea:focus{outline:none;border-color:#3b82f6;background:#fff}
  .fac-form-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
  .fac-modal-actions{display:flex;gap:10px;justify-content:flex-end;margin-top:20px;padding-top:16px;border-top:1px solid #f1f5f9}

  /* ─── EMPTY STATE ────────────────────────────── */
  .empty-state{text-align:center;padding:40px;color:#94a3b8}
  .empty-state i{font-size:40px;margin-bottom:12px;display:block;opacity:.5}
  .empty-state p{font-size:14px}

  /* ─── TOAST ──────────────────────────────────── */
  .toast-container{position:fixed;top:16px;right:16px;z-index:9999}
  .toast{background:#fff;border-radius:10px;padding:12px 16px;box-shadow:0 8px 24px rgba(0,0,0,.12);border-left:4px solid #3b82f6;margin-bottom:8px;font-size:13px;transform:translateX(110%);opacity:0;transition:all .25s;display:flex;align-items:center;gap:8px;min-width:220px}
  .toast.show{transform:translateX(0);opacity:1}
  .toast.success{border-left-color:#22c55e}
  .toast.error{border-left-color:#ef4444}
  .toast.info{border-left-color:#0ea5e9}

  /* ─── DASHBOARD CARDS ────────────────────────── */
  .dash-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;margin-bottom:20px}
  .dash-card{background:#fff;border-radius:14px;padding:20px;box-shadow:0 2px 8px rgba(18,40,58,.04);display:flex;flex-direction:column;gap:6px}
  .dash-card-header{display:flex;align-items:center;justify-content:space-between}
  .dash-card-icon{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px}
  .dash-card-val{font-size:30px;font-weight:800;color:#0f172a;line-height:1}
  .dash-card-label{font-size:12px;font-weight:600;color:#64748b}
  .dash-card-trend{font-size:11px;font-weight:600;margin-top:2px}
  .dash-quicklinks{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:10px;margin-bottom:20px}
  .qlink{display:flex;align-items:center;gap:10px;padding:14px 16px;background:#fff;border-radius:12px;box-shadow:0 2px 8px rgba(18,40,58,.04);text-decoration:none;color:#334155;transition:all .15s;font-size:13px;font-weight:600;border:1px solid #f1f5f9}
  .qlink:hover{background:#f8fafc;border-color:#e2e8f0;transform:translateY(-1px);box-shadow:0 4px 14px rgba(18,40,58,.08)}
  .qlink i{width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:15px}

  /* ─── ESTOQUE SPECIFIC ───────────────────────── */
  .stock-progress{height:6px;border-radius:3px;background:#e2e8f0;overflow:hidden;margin-top:4px}
  .stock-bar{height:100%;border-radius:3px;background:#22c55e;transition:width .3s}
  .stock-bar.warn{background:#f59e0b}
  .stock-bar.danger{background:#ef4444}
</style>
</head>
<body>
<div class="layout" id="app">

  <!-- ══════════ SIDEBAR ══════════ -->
  <aside class="sidebar" id="sidebar">
    <div class="brand">
      <img src="https://columbiamachine.com/wp-content/uploads/2018/12/colmac_logo-blue-1.png" alt="Columbia" onerror="this.style.display='none'">
      <div class="brand-text">Facilities<small>Columbia Machine</small></div>
    </div>
    <nav style="flex:1;padding-bottom:16px">
      <div class="nav-section">Principal</div>
      <button class="nav-item active" onclick="nav('dashboard')" id="nav-dashboard">
        <i class="fas fa-tachometer-alt"></i> Dashboard
      </button>
      <button class="nav-item" onclick="nav('epi')" id="nav-epi">
        <i class="fas fa-hard-hat"></i> Solicitações EPI
        <span class="nav-badge" id="nbEpi" style="display:none">0</span>
      </button>
      <button class="nav-item" onclick="nav('alertas')" id="nav-alertas">
        <i class="fas fa-exclamation-triangle"></i> Alertas NR-6
        <span class="nav-badge warn" id="nbAlertas" style="display:none">0</span>
      </button>
      <button class="nav-item" onclick="nav('estoque')" id="nav-estoque">
        <i class="fas fa-boxes"></i> Estoque
        <span class="nav-badge warn" id="nbEstoque" style="display:none">0</span>
      </button>
      <button class="nav-item" onclick="nav('chamados')" id="nav-chamados">
        <i class="fas fa-ticket-alt"></i> Chamados
        <span class="nav-badge" id="nbChamados" style="display:none">0</span>
      </button>

      <div class="nav-section">Operação</div>
      <button class="nav-item" onclick="nav('limpeza')" id="nav-limpeza">
        <i class="fas fa-broom"></i> Limpezas
      </button>
      <button class="nav-item" onclick="nav('templates')" id="nav-templates">
        <i class="fas fa-clipboard-list"></i> Templates Limpeza
      </button>
      <button class="nav-item" onclick="nav('projetos')" id="nav-projetos">
        <i class="fas fa-tasks"></i> Projetos
      </button>

      <div class="nav-section">Cadastros</div>
      <button class="nav-item" onclick="nav('colaboradores')" id="nav-colaboradores">
        <i class="fas fa-users"></i> Colaboradores
      </button>
      <button class="nav-item" onclick="nav('materiais')" id="nav-materiais">
        <i class="fas fa-box"></i> Materiais EPI
      </button>
      <button class="nav-item" onclick="nav('ciclos')" id="nav-ciclos">
        <i class="fas fa-sync-alt"></i> Ciclos NR-6
      </button>

      <div class="nav-divider"></div>
      <button class="nav-item" onclick="nav('relatorios')" id="nav-relatorios">
        <i class="fas fa-chart-bar"></i> Relatórios
      </button>
      <button class="nav-item" onclick="nav('auditoria')" id="nav-auditoria">
        <i class="fas fa-history"></i> Auditoria
      </button>
      <div class="nav-divider"></div>
      <a href="/" class="nav-back"><i class="fas fa-arrow-left"></i> Voltar ao sistema</a>
    </nav>
  </aside>

  <!-- ══════════ MAIN ══════════ -->
  <div class="main">
    <header class="topbar">
      <div class="topbar-left">
        <button class="hamburger" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
        <div>
          <h1 id="topbarTitle">Dashboard</h1>
          <div class="breadcrumb">Facilities / <span id="topbarSub">Visão Geral</span></div>
        </div>
      </div>
      <div class="topbar-right">
        <a href="/facilities/solicitar-epi" class="topbar-btn topbar-btn-green"><i class="fas fa-plus"></i> Nova Solicitação</a>
        <a href="/facilities/almoxarife" class="topbar-btn topbar-btn-ghost" target="_blank"><i class="fas fa-boxes"></i> Almoxarife</a>
        <button class="topbar-btn topbar-btn-ghost" onclick="refreshPage()"><i class="fas fa-sync"></i></button>
      </div>
    </header>

    <!-- ─── DASHBOARD ─── -->
    <div class="page active" id="pageDashboard">
      <div class="dash-cards" id="dashCards">
        <div class="dash-card"><div class="dash-card-header"><div class="dash-card-icon" style="background:#fef3c7;color:#d97706"><i class="fas fa-clock"></i></div></div><div class="dash-card-val" id="dEpiPend">-</div><div class="dash-card-label">EPIs Aguardando</div></div>
        <div class="dash-card"><div class="dash-card-header"><div class="dash-card-icon" style="background:#d1fae5;color:#059669"><i class="fas fa-check-circle"></i></div></div><div class="dash-card-val" id="dEpiLib">-</div><div class="dash-card-label">Liberados Hoje</div></div>
        <div class="dash-card"><div class="dash-card-header"><div class="dash-card-icon" style="background:#fee2e2;color:#dc2626"><i class="fas fa-exclamation-circle"></i></div></div><div class="dash-card-val" id="dVencidos">-</div><div class="dash-card-label">EPIs Vencidos/Vencendo</div></div>
        <div class="dash-card"><div class="dash-card-header"><div class="dash-card-icon" style="background:#dbeafe;color:#2563eb"><i class="fas fa-ticket-alt"></i></div></div><div class="dash-card-val" id="dChamados">-</div><div class="dash-card-label">Chamados Abertos</div></div>
        <div class="dash-card"><div class="dash-card-header"><div class="dash-card-icon" style="background:#ede9fe;color:#7c3aed"><i class="fas fa-boxes"></i></div></div><div class="dash-card-val" id="dEstoqBaixo">-</div><div class="dash-card-label">Itens Abaixo do Mínimo</div></div>
        <div class="dash-card"><div class="dash-card-header"><div class="dash-card-icon" style="background:#f0fdf4;color:#15803d"><i class="fas fa-broom"></i></div></div><div class="dash-card-val" id="dLimpezas">-</div><div class="dash-card-label">Limpezas Hoje</div></div>
        <div class="dash-card"><div class="dash-card-header"><div class="dash-card-icon" style="background:#fff7ed;color:#ea580c"><i class="fas fa-tasks"></i></div></div><div class="dash-card-val" id="dProjetos">-</div><div class="dash-card-label">Projetos Ativos</div></div>
        <div class="dash-card"><div class="dash-card-header"><div class="dash-card-icon" style="background:#f0f9ff;color:#0369a1"><i class="fas fa-users"></i></div></div><div class="dash-card-val" id="dColabs">-</div><div class="dash-card-label">Colaboradores Ativos</div></div>
      </div>
      <div class="sec-hdr"><h2 class="sec-title"><i class="fas fa-bolt" style="color:#f59e0b"></i>Acesso Rápido</h2></div>
      <div class="dash-quicklinks">
        <a href="/facilities/solicitar-epi" class="qlink"><i class="fas fa-plus-circle" style="background:#d1fae5;color:#059669"></i> Solicitar EPI</a>
        <a href="/facilities/almoxarife" class="qlink" target="_blank"><i class="fas fa-boxes" style="background:#dbeafe;color:#2563eb"></i> Almoxarife</a>
        <a href="/facilities/minhas-solicitacoes" class="qlink" target="_blank"><i class="fas fa-clipboard-list" style="background:#ede9fe;color:#7c3aed"></i> Minhas Solicits.</a>
        <a href="/facilities/relatorio-consumo" class="qlink" target="_blank"><i class="fas fa-chart-bar" style="background:#fef3c7;color:#d97706"></i> Rel. Consumo</a>
        <a href="/facilities/cronograma-limpeza" class="qlink" target="_blank"><i class="fas fa-calendar-alt" style="background:#f0fdf4;color:#15803d"></i> Cronograma</a>
        <button class="qlink" onclick="nav('chamados')"><i class="fas fa-ticket-alt" style="background:#fee2e2;color:#dc2626"></i> Chamados</button>
      </div>
      <div style="background:#fff;border-radius:14px;padding:20px;box-shadow:0 2px 8px rgba(18,40,58,.04)">
        <div class="sec-hdr"><h2 class="sec-title"><i class="fas fa-hard-hat" style="color:#f59e0b"></i> Últimas Solicitações EPI</h2></div>
        <table class="fac-table"><thead><tr><th>Funcionário</th><th>Item</th><th>Solicitado por</th><th>Data</th><th>Status</th><th>Ações</th></tr></thead>
        <tbody id="dashEpiBody"></tbody></table>
      </div>
    </div>

    <!-- ─── SOLICITAÇÕES EPI ─── -->
    <div class="page" id="pageEpi">
      <div class="sec-hdr">
        <h2 class="sec-title"><i class="fas fa-hard-hat" style="color:#f59e0b"></i> Solicitações EPI / Uniforme</h2>
        <div class="sec-actions">
          <a href="/facilities/solicitar-epi" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Nova</a>
        </div>
      </div>
      <div class="filter-bar">
        <input id="filterEpiBusca" type="search" placeholder="Buscar nome/item..." style="flex:1;min-width:160px" oninput="debounceEpi()">
        <select id="filterEpiStatus" onchange="loadEpi()">
          <option value="">Todos status</option>
          <option value="solicitado" selected>Pendentes</option>
          <option value="liberado">Liberadas</option>
          <option value="retirado">Retiradas</option>
          <option value="negado">Negadas</option>
          <option value="cancelado">Canceladas</option>
        </select>
        <select id="filterEpiTipo" onchange="loadEpi()">
          <option value="">Todos tipos</option>
          <option value="epi">EPI</option>
          <option value="uniforme">Uniforme</option>
        </select>
        <input id="filterEpiIni" type="date" onchange="loadEpi()" title="De">
        <input id="filterEpiFim" type="date" onchange="loadEpi()" title="Até">
        <button class="btn btn-ghost btn-sm" onclick="loadEpi()"><i class="fas fa-sync"></i></button>
      </div>
      <div id="epiLoteBar" class="lote-bar" style="display:none">
        <span id="epiLoteCount">0 selecionadas</span>
        <button class="btn btn-green btn-sm" onclick="acaoLote('liberar')"><i class="fas fa-check"></i> Liberar</button>
        <button class="btn btn-red btn-sm" onclick="acaoLote('negar')"><i class="fas fa-times"></i> Negar</button>
        <button class="btn btn-ghost btn-sm" onclick="acaoLote('cancelar')"><i class="fas fa-ban"></i> Cancelar</button>
      </div>
      <div class="tbl-wrap">
        <table class="fac-table">
          <thead><tr>
            <th style="width:32px"><input type="checkbox" id="epiSelAll" onchange="toggleSelAll(this)"></th>
            <th>Funcionário</th><th>Solicitado por</th><th>Item</th><th>Tam.</th><th>Qtd</th><th>Data</th><th>Status</th><th>Ações</th>
          </tr></thead>
          <tbody id="epiTableBody"></tbody>
        </table>
      </div>
    </div>

    <!-- ─── ALERTAS NR-6 ─── -->
    <div class="page" id="pageAlertas">
      <div class="sec-hdr">
        <h2 class="sec-title"><i class="fas fa-exclamation-triangle" style="color:#f59e0b"></i> Alertas NR-6 — Vencimentos</h2>
        <div class="sec-actions">
          <button class="btn btn-amber btn-sm" onclick="enviarLembretes()"><i class="fas fa-envelope"></i> Enviar Lembretes</button>
        </div>
      </div>
      <div class="tbl-wrap">
        <table class="fac-table">
          <thead><tr><th>Colaborador</th><th>Setor</th><th>Item</th><th>Retirada</th><th>Próx. Troca</th><th>Situação</th><th>Ações</th></tr></thead>
          <tbody id="alertasTableBody"></tbody>
        </table>
      </div>
    </div>

    <!-- ─── ESTOQUE ─── -->
    <div class="page" id="pageEstoque">
      <div class="sec-hdr">
        <h2 class="sec-title"><i class="fas fa-boxes" style="color:#7c3aed"></i> Estoque EPI / Uniforme</h2>
        <div class="sec-actions">
          <button class="btn btn-purple btn-sm" onclick="openEstoqueModal()"><i class="fas fa-plus"></i> Novo Item</button>
          <button class="btn btn-ghost btn-sm" onclick="loadEstoque()"><i class="fas fa-sync"></i></button>
        </div>
      </div>
      <div class="filter-bar">
        <input id="filtEstBusca" type="search" placeholder="Buscar material..." style="flex:1;min-width:160px" oninput="debounceEstoque()">
        <select id="filtEstStatus" onchange="loadEstoque()">
          <option value="">Todo estoque</option>
          <option value="baixo">Abaixo do mínimo</option>
          <option value="zerado">Sem estoque</option>
        </select>
      </div>
      <div class="tbl-wrap">
        <table class="fac-table">
          <thead><tr>
            <th>Material</th><th>Tipo</th><th>N° CA</th><th>Lote</th><th>Validade</th>
            <th>Localização</th><th>Estoque</th><th>Mínimo</th><th>Status</th><th>Ações</th>
          </tr></thead>
          <tbody id="estoqueTableBody"></tbody>
        </table>
      </div>
    </div>

    <!-- ─── CHAMADOS ─── -->
    <div class="page" id="pageChamados">
      <div class="sec-hdr">
        <h2 class="sec-title"><i class="fas fa-ticket-alt" style="color:#2563eb"></i> Chamados de Facilities</h2>
        <div class="sec-actions">
          <button class="btn btn-primary btn-sm" onclick="openChamadoModal()"><i class="fas fa-plus"></i> Novo Chamado</button>
          <button class="btn btn-ghost btn-sm" onclick="loadChamados()"><i class="fas fa-sync"></i></button>
        </div>
      </div>
      <div class="filter-bar">
        <input id="filtChamBusca" type="search" placeholder="Buscar chamado..." style="flex:1;min-width:160px" oninput="debounceChamados()">
        <select id="filtChamStatus" onchange="loadChamados()">
          <option value="">Todos status</option>
          <option value="aberto" selected>Abertos</option>
          <option value="em_analise">Em Análise</option>
          <option value="aprovado">Aprovados</option>
          <option value="em_execucao">Em Execução</option>
          <option value="concluido">Concluídos</option>
          <option value="cancelado">Cancelados</option>
        </select>
        <select id="filtChamCategoria" onchange="loadChamados()">
          <option value="">Todas categorias</option>
          <option value="manutencao">Manutenção</option>
          <option value="limpeza">Limpeza</option>
          <option value="reposicao">Reposição</option>
          <option value="outros">Outros</option>
        </select>
        <select id="filtChamPrior" onchange="loadChamados()">
          <option value="">Todas prioridades</option>
          <option value="urgente">Urgente</option>
          <option value="alta">Alta</option>
          <option value="media">Média</option>
          <option value="baixa">Baixa</option>
        </select>
      </div>
      <div class="tbl-wrap">
        <table class="fac-table">
          <thead><tr><th>#</th><th>Título</th><th>Categoria</th><th>Prioridade</th><th>Local</th><th>Aberto por</th><th>Responsável</th><th>Aberto em</th><th>Status</th><th>Ações</th></tr></thead>
          <tbody id="chamadosTableBody"></tbody>
        </table>
      </div>
    </div>

    <!-- ─── LIMPEZA ─── -->
    <div class="page" id="pageLimpeza">
      <div class="sec-hdr">
        <h2 class="sec-title"><i class="fas fa-broom" style="color:#0ea5e9"></i> Cronograma de Limpeza</h2>
        <div class="sec-actions">
          <button class="btn btn-sky btn-sm" onclick="gerarLimpezasSemana()"><i class="fas fa-calendar-plus"></i> Gerar 7 dias</button>
          <button class="btn btn-primary btn-sm" onclick="openLimpezaModal()"><i class="fas fa-plus"></i> Nova</button>
        </div>
      </div>
      <div class="tbl-wrap">
        <table class="fac-table">
          <thead><tr><th>Data</th><th>Título</th><th>Local</th><th>Responsável</th><th>Horário</th><th>Status</th></tr></thead>
